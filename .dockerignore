target
reference
# The labelled matching corpus (data/corpus, ~8 MB) is never needed at runtime: keep it
# out of the build context, except decisions.json, which the engine compiles in
# (crates/crosstalk-matching/src/engine.rs include_str!).
data/corpus
!data/corpus/decisions.json
.git
.remember
docs
*.db
# Operator config may inline the UI token and the Dispatcharr key: never send it in the
# build context. The commented examples are still needed by the Dockerfile's config copy.
config/*.toml
!config/*.example.toml
# Save temp files are `.{name}.tmp.{pid}.{counter}` inside the config dir; exports are
# dated reports. Neither belongs in the build context.
config/.*.tmp.*
config/*.toml.tmp.*
config/exports/
.env
docker-compose.yml
